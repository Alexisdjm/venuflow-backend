NODE_ENV=development
PORT=3000
# Local Docker only. Supabase staging belongs in .env.staging, never here.
DATABASE_URL=postgresql://venueflow:change_me@localhost:5432/venueflow?schema=public
POSTGRES_USER=venueflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=venueflow
POSTGRES_PORT=5432
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
SWAGGER_ENABLED=true
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VenueFlow
PUBLIC_BOOKING_BASE_URL=http://localhost:3002
PUBLIC_BOOKING_ROOT_DOMAIN=localhost
PUBLIC_BOOKING_PROTOCOL=http
PUBLIC_BOOKING_PORT=3002
# Private folder for payment screenshots. Defaults to storage/payment-proofs.
# PAYMENT_PROOF_DIR=
# Capturas de adelanto: se borran al rechazar o al vencer, y a los 45 días si la cita se confirmó.
# Official BCV mirror and Binance P2P quote. Defaults are the public endpoints.
# DOLARAPI_BASE_URL=https://ve.dolarapi.com
# BINANCE_P2P_QUOTE_URL=https://www.binance.com/bapi/c2c/v1/public/c2c/agent/quote-price
