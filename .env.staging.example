NODE_ENV=development
PORT=3000

# Session pooler URI from Supabase > Connect. Never commit the real value.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Use a staging-only random secret with at least 32 characters.
JWT_ACCESS_SECRET=replace_with_a_staging_only_random_secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3001
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VenueFlow
PUBLIC_BOOKING_BASE_URL=http://localhost:3002
