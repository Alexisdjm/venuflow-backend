NODE_ENV=development
PORT=3000

# Supabase > Connect > Session pooler. Do not commit the real value.
# User: postgres.PROJECT_REF. Host: *.pooler.supabase.com. Port: 5432. Database: postgres.
# URL-encode any reserved character in the password.
# Port 6543 is the transaction pooler. Do not use it here.
# sslmode=require encrypts the session. Prisma CLI understands it directly.
# The Nest adapter matches that mode for node-pg 8. No second URL is required.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Staging-only secret, at least 32 characters. Do not reuse the local or production secret.
JWT_ACCESS_SECRET=replace_with_a_staging_only_random_secret
# Optional separate secret for public booking links. Falls back to JWT_ACCESS_SECRET.
PUBLIC_BOOKING_TOKEN_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

SWAGGER_ENABLED=true
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3001
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VenueFlow
PUBLIC_BOOKING_BASE_URL=http://localhost:3002
PUBLIC_BOOKING_ROOT_DOMAIN=tryvenueflow.com

# Used only by staging:seed. Not required to check the connection.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_FIRST_NAME=
PLATFORM_ADMIN_LAST_NAME=
