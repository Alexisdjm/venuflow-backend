NODE_ENV=production
VENUEFLOW_ENV=production
PORT=3000

# Supabase production > Connect > Session pooler. Do not commit the real value.
# User: postgres.<production project ref>. Host: *.pooler.supabase.com. Port: 5432. Database: postgres.
# Use the production project. Do not copy the staging host, user, password, or JWT.
# URL-encode any reserved character in the password.
# Port 6543 is the transaction pooler. Do not use it here.
DATABASE_URL=postgresql://postgres.PRODUCTION_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Production-only secret, at least 32 characters. Do not reuse local or staging.
JWT_ACCESS_SECRET=replace_with_a_production_only_random_secret
# Required in production. Must differ from JWT_ACCESS_SECRET. Signs public booking links.
PUBLIC_BOOKING_TOKEN_SECRET=replace_with_a_different_production_booking_secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

SWAGGER_ENABLED=false
TRUST_PROXY=false
CORS_ORIGINS=https://app.tryvenueflow.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VenueFlow
PUBLIC_BOOKING_ROOT_DOMAIN=tryvenueflow.com
PUBLIC_BOOKING_PROTOCOL=https

# Not used by production:target, production:check, or production:migrate.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_FIRST_NAME=
PLATFORM_ADMIN_LAST_NAME=
