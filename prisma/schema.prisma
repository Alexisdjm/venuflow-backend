generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SpaStatus {
  ACTIVE
  SUSPENDED
}
enum UserRole {
  PLATFORM_ADMIN
  SPA_ADMIN
  PROFESSIONAL
}
enum UserStatus {
  ACTIVE
  SUSPENDED
}
enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}
enum ServiceDurationType {
  FIXED
  VARIABLE
}
enum ServicePriceType {
  FIXED
  VARIABLE
}

model Spa {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  slug      String     @unique
  status    SpaStatus  @default(ACTIVE)
  timezone  String
  currency  String     @db.VarChar(3)
  openingMinute Int     @default(540)
  closingMinute Int     @default(1080)
  walkInGraceMinutes Int @default(5)
  users     User[]
  professionals Professional[]
  services  SpaService[]
  schedules ProfessionalSchedule[]
  auditLogs AuditLog[]
  appointments Appointment[]
  customers Customer[]
  serviceCategories ServiceCategory[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  spaId        String?     @db.Uuid
  spa          Spa?        @relation(fields: [spaId], references: [id], onDelete: Restrict)
  firstName    String
  lastName     String
  email        String      @unique
  passwordHash String
  role         UserRole
  status       UserStatus  @default(ACTIVE)
  professional Professional?
  sessions     Session[]
  auditLogs    AuditLog[] @relation("AuditActor")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([id, spaId])
  @@index([spaId])
}

model Professional {
  id             String   @id @default(uuid()) @db.Uuid
  spaId          String   @db.Uuid
  userId         String   @unique @db.Uuid
  spa            Spa      @relation(fields: [spaId], references: [id], onDelete: Restrict)
  user           User     @relation(fields: [userId, spaId], references: [id, spaId], onDelete: Restrict)
  services       ProfessionalService[]
  schedules      ProfessionalSchedule[]
  appointments   Appointment[]
  displayName    String
  commissionRate Decimal  @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([id, spaId])
  @@unique([userId, spaId])
  @@index([spaId])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId          String    @db.Uuid
  tokenHash         String    @unique @db.VarChar(64)
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @db.Uuid
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  spaId       String?  @db.Uuid
  spa         Spa?     @relation(fields: [spaId], references: [id], onDelete: SetNull)
  actorUserId String?  @db.Uuid
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([spaId, createdAt])
  @@index([actorUserId, createdAt])
}

model SpaService {
  id              String   @id @default(uuid()) @db.Uuid
  spaId           String   @db.Uuid
  spa             Spa      @relation(fields: [spaId], references: [id], onDelete: Restrict)
  name            String
  description     String?
  categoryId      String   @db.Uuid
  category        ServiceCategory @relation(fields: [categoryId, spaId], references: [id, spaId], onDelete: Restrict)
  durationType    ServiceDurationType @default(FIXED)
  durationMinutes Int?
  priceType       ServicePriceType @default(FIXED)
  price           Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  professionals   ProfessionalService[]
  appointments    Appointment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([id, spaId])
  @@unique([spaId, name])
  @@index([spaId])
}

model ProfessionalService {
  spaId          String       @db.Uuid
  professionalId String       @db.Uuid
  serviceId      String       @db.Uuid
  professional   Professional @relation(fields: [professionalId, spaId], references: [id, spaId], onDelete: Cascade)
  service        SpaService   @relation(fields: [serviceId, spaId], references: [id, spaId], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([professionalId, serviceId])
  @@index([spaId])
}

model ProfessionalSchedule {
  id             String       @id @default(uuid()) @db.Uuid
  spaId          String       @db.Uuid
  professionalId String       @db.Uuid
  spa            Spa          @relation(fields: [spaId], references: [id], onDelete: Restrict)
  professional   Professional @relation(fields: [professionalId, spaId], references: [id, spaId], onDelete: Cascade)
  dayOfWeek      Int
  startMinute    Int
  endMinute      Int
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([id, spaId])
  @@unique([professionalId, dayOfWeek, startMinute, endMinute])
  @@index([spaId, professionalId, dayOfWeek])
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  spaId          String            @db.Uuid
  professionalId String            @db.Uuid
  serviceId      String            @db.Uuid
  customerId     String            @db.Uuid
  spa            Spa               @relation(fields: [spaId], references: [id], onDelete: Restrict)
  professional   Professional      @relation(fields: [professionalId, spaId], references: [id, spaId], onDelete: Restrict)
  service        SpaService        @relation(fields: [serviceId, spaId], references: [id, spaId], onDelete: Restrict)
  customer       Customer          @relation(fields: [customerId, spaId], references: [id, spaId], onDelete: Restrict)
  customerName   String
  customerPhone  String
  customerNationalId String?
  customerEmail  String?
  notes          String?
  startAt        DateTime
  endAt          DateTime
  appointmentDate DateTime          @db.Date
  status         AppointmentStatus @default(CONFIRMED)
  serviceCategoryId String         @db.Uuid
  serviceCategory ServiceCategory   @relation(fields: [serviceCategoryId, spaId], references: [id, spaId], onDelete: Restrict)
  servicePrice   Decimal           @db.Decimal(10, 2)
  commissionRate Decimal           @db.Decimal(5, 2)
  isWalkIn       Boolean           @default(false)
  createdById    String            @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([id, spaId])
  @@index([spaId, startAt])
  @@index([professionalId, startAt])
  @@index([customerId, startAt])
}

model ServiceCategory {
  id             String        @id @default(uuid()) @db.Uuid
  spaId          String        @db.Uuid
  spa            Spa           @relation(fields: [spaId], references: [id], onDelete: Restrict)
  name           String
  normalizedName String
  sortOrder      Int           @default(0)
  services       SpaService[]
  appointments   Appointment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([id, spaId])
  @@unique([spaId, normalizedName])
  @@index([spaId, sortOrder])
  @@map("service_categories")
}

model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  spaId        String        @db.Uuid
  spa          Spa           @relation(fields: [spaId], references: [id], onDelete: Restrict)
  name         String
  phone        String
  nationalId   String?
  email        String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([id, spaId])
  @@unique([spaId, nationalId])
  @@index([spaId, name])
}
